{
  "name": "vercel-ai-shopsavvy",
  "version": "0.1.0",
  "description": "Vercel AI SDK tools for ShopSavvy product search, price comparison, price history, and deals",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "vercel-ai",
    "ai-sdk",
    "ai",
    "tools",
    "llm",
    "shopsavvy",
    "shopping",
    "price-comparison",
    "price-history",
    "deals"
  ],
  "license": "MIT",
  "author": "ShopSavvy by Monolith Technologies, Inc.",
  "homepage": "https://shopsavvy.com/integrations/vercel-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopsavvy/vercel-ai-shopsavvy.git"
  },
  "bugs": {
    "url": "https://github.com/shopsavvy/vercel-ai-shopsavvy/issues"
  },
  "dependencies": {
    "@shopsavvy/sdk": "^1.1.0"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@types/bun": "latest",
    "ai": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "zod": "^4.1.8"
  }
}
